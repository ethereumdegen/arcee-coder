# Database (NeonDB)
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/starflask?sslmode=require

# Server
PORT=3000
SITE_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Admin auth
ADMIN_PASSWORD=changeme
ADMIN_JWT_SECRET=changeme-to-random-secret

# Email (Resend)
RESEND_API_KEY=re_xxx
NOTIFICATION_EMAIL=team@starflaskdigital.com

# S3 / DigitalOcean Spaces (optional — uploads disabled if not set)
S3_BUCKET=starflask-uploads
S3_REGION=nyc3
S3_ENDPOINT=https://nyc3.digitaloceanspaces.com
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key
